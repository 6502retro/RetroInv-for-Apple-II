10 REM ================================
11 REM  RETROINV - RETRO COMPUTER
12 REM  COLLECTION INVENTORY
13 REM  BY 6502RETRO  -  VERSION 1.4
14 REM  APPLESOFT BASIC / DOS 3.3 / PRODOS
15 REM ================================
16 REM  COMPILER-CLEAN: TASC / BEAGLE
50 MX = 138: DIM N$(138),M$(138),Y$(138),T(138),C(138),L$(138),V(138),O$(138),SN$(138): REM KEEP DIMS = MX (SAME LIMIT AS THE MOUSE VERSION)
55 DIM ID(138),PA(138),SL(138): REM ITEM NO., PART OF (ITEM NO.), SLOT
60 DIM T$(8),C$(6),TC(8),VD(8),VC(8)
70 FOR I = 1 TO 8: READ T$(I): NEXT
80 FOR I = 1 TO 6: READ C$(I): NEXT
90 DATA COMPUTER,PERIPHERAL,SOFTWARE,ACCESSORY,DOCUMENTATION,OTHER,CARD,PART
100 DATA MINT,EXCELLENT,GOOD,FAIR,POOR,FOR PARTS
110 D$ = CHR$(4): Q$ = CHR$(34): F$ = "RETROINV.DAT": TF$ = "RETROINV.SAVING": N = 0: CH = 0: QF = 0: NX = 1: TR = 0
120 B$ = "": R$ = "": FOR I = 1 TO 39: B$ = B$ + " ": NEXT: FOR I = 1 TO 38: R$ = R$ + "-": NEXT
130 GOSUB 1000: GOTO 8000
990 REM --- TITLE SCREEN ---
1000 TEXT: HOME
1010 VTAB 4: PRINT R$
1020 VTAB 7: HTAB 16: INVERSE: PRINT " RETROINV ": NORMAL
1030 VTAB 9: HTAB 9: PRINT "RETRO COMPUTER INVENTORY"
1040 VTAB 11: HTAB 15: PRINT "BY 6502RETRO"
1050 VTAB 13: HTAB 15: PRINT "VERSION 1.4"
1060 VTAB 16: PRINT R$
1070 VTAB 20: HTAB 10: PRINT "PRESS ANY KEY TO BEGIN";: GOSUB 7800
1080 RETURN
1890 REM --- SCREEN HEADER ---
1900 VTAB 1: INVERSE: PRINT LEFT$(" RETROINV  BY 6502RETRO" + B$,39): NORMAL
1910 PRINT "ITEMS: ";N;" OF ";MX;: IF CH THEN HTAB 31: PRINT "*UNSAVED";
1920 PRINT : RETURN
1990 REM --- MAIN MENU ---
2000 HOME: GOSUB 1900
2010 VTAB 5: HTAB 10: PRINT "1) ADD AN ITEM"
2020 HTAB 10: PRINT "2) BROWSE / EDIT / DELETE"
2030 HTAB 10: PRINT "3) LIST ALL ITEMS"
2040 HTAB 10: PRINT "4) SEARCH"
2050 HTAB 10: PRINT "5) SORT BY NAME"
2060 HTAB 10: PRINT "6) COLLECTION REPORT"
2070 HTAB 10: PRINT "7) SAVE TO DISK"
2080 HTAB 10: PRINT "8) QUIT"
2090 VTAB 16: HTAB 10: PRINT "CHOICE (1-8)? ";
2100 GOSUB 7800: K = VAL(K$): IF K < 1 OR K > 8 THEN 2100
2110 IF K = 7 THEN QF = 0: GOTO 8500
2115 IF K = 8 THEN 9500
2120 ON K GOSUB 3000,4000,5000,5500,6000,6500
2130 GOTO 2000
2990 REM --- ADD ITEM ---
3000 IF N >= MX THEN HOME: GOSUB 1900: PRINT : PRINT "INVENTORY IS FULL (";MX;" ITEMS).": GOSUB 7900: RETURN
3005 X = PEEK(111) + PEEK(112) * 256 - PEEK(109) - PEEK(110) * 256: IF X < 700 THEN X = FRE(0): IF X < 0 THEN X = X + 65536
3006 IF X < 700 THEN HOME: GOSUB 1900: PRINT : PRINT "NOT ENOUGH MEMORY FOR MORE ITEMS.": GOSUB 7900: RETURN
3010 HOME: GOSUB 1900: I = N + 1: PRINT "ADD A NEW ITEM"
3020 N$(I) = "":M$(I) = "":Y$(I) = "":T(I) = 1:C(I) = 3:L$(I) = "":V(I) = 0:O$(I) = "":SN$(I) = "":ID(I) = 0:PA(I) = 0:SL(I) = 0
3030 GOSUB 3500
3040 IF N$(I) = "" THEN PRINT : PRINT "NO NAME ENTERED - ITEM NOT ADDED.": GOSUB 7900: RETURN
3050 N = I: GOSUB 7780: CH = 1: PRINT : PRINT "ITEM NO. ";ID(I);" ADDED.": GOSUB 7900: RETURN
3490 REM --- FIELD EDITOR FOR RECORD I (RETURN KEEPS VALUE) ---
3500 OT = T(I): PRINT "NAME/MODEL [";N$(I);"]": PRINT "> ";: L = 30: GOSUB 7000: IF A$ <> "" THEN N$(I) = A$
3510 PRINT "MAKER [";M$(I);"]": PRINT "> ";: L = 20: GOSUB 7000: IF A$ <> "" THEN M$(I) = A$
3515 PRINT "SERIAL # [";SN$(I);"]": PRINT "> ";: L = 20: GOSUB 7000: IF A$ <> "" THEN SN$(I) = A$
3520 PRINT "YEAR [";Y$(I);"]": PRINT "> ";: L = 4: GOSUB 7000: IF A$ = "" THEN 3530
3522 Z = 1: IF LEN(A$) <> 4 OR A$ < "1000" OR A$ > "2999" THEN Z = 0
3524 FOR J = 1 TO LEN(A$): K = ASC(MID$(A$,J,1)): IF K < 48 OR K > 57 THEN Z = 0
3526 NEXT J: IF Z THEN Y$(I) = A$: GOTO 3530
3528 PRINT "PLEASE USE FOUR DIGITS, LIKE 1984.": GOTO 3520
3530 PRINT "1)COMPUTER 2)PERIPHERAL 3)SOFTWARE"
3531 PRINT "4)ACCESSORY 5)DOCUMENTATION 6)OTHER": PRINT "7)CARD 8)PART"
3535 PRINT "TYPE [";T$(T(I));"]? ";: GOSUB 7800: K = VAL(K$): IF K >= 1 AND K <= 8 THEN T(I) = K
3537 PRINT T$(T(I))
3540 PRINT "1)MINT 2)EXCELLENT 3)GOOD 4)FAIR": PRINT "5)POOR 6)FOR PARTS"
3545 PRINT "CONDITION [";C$(C(I));"]? ";: GOSUB 7800: K = VAL(K$): IF K >= 1 AND K <= 6 THEN C(I) = K
3547 PRINT C$(C(I))
3550 PRINT "LOCATION [";L$(I);"]": PRINT "> ";: L = 20: GOSUB 7000: IF A$ <> "" THEN L$(I) = A$
3560 X = V(I): GOSUB 7600: PRINT "VALUE [";S$;"]": PRINT "> $";: L = 12: GOSUB 7000: IF A$ = "" THEN 3570
3562 W$ = "": FOR J = 1 TO LEN(A$): K$ = MID$(A$,J,1): IF K$ <> "," AND K$ <> "$" THEN W$ = W$ + K$
3564 NEXT J: Z = VAL(W$): IF Z >= 0 AND Z <= 9999999.99 THEN V(I) = INT(Z * 100 + .5) / 100: GOTO 3570
3566 PRINT "VALUE MUST BE 0 TO 9999999.99.": GOTO 3560
3570 PRINT "NOTES [";O$(I);"]": PRINT "> ";: L = 60: GOSUB 7000: IF A$ <> "" THEN O$(I) = A$
3571 IF OT = 1 AND T(I) <> 1 THEN DI = ID(I): GOSUB 7760
3572 IF T(I) = 1 THEN PA(I) = 0: SL(I) = 0: RETURN
3573 GOSUB 7700: PRINT "PART OF ITEM NO. [";PA(I);" ";LEFT$(PN$,14);"]"
3574 PRINT "(0 = NONE) > ";: L = 5: GOSUB 7000: K = VAL(A$): Z = 0: IF A$ = "" THEN 3578
3575 IF K = 0 THEN PA(I) = 0: GOTO 3578
3576 FOR J = 1 TO N: IF ID(J) = K AND T(J) = 1 THEN Z = J
3577 NEXT J: IF Z THEN PA(I) = K
3578 IF A$ <> "" AND K > 0 AND Z = 0 THEN PRINT "NO COMPUTER HAS THAT ITEM NO."
3579 GOSUB 7750: PRINT "SLOT 0-7, A)UX, N)ONE [";SS$;"]? ";: GOSUB 7800: IF K$ >= "0" AND K$ <= "7" THEN SL(I) = VAL(K$) + 1
3580 IF K$ = "A" THEN SL(I) = 9
3581 IF K$ = "N" THEN SL(I) = 0
3582 GOSUB 7750: PRINT SS$: RETURN
3990 REM --- BROWSE / EDIT / DELETE ---
4000 IF N = 0 THEN GOSUB 7950: RETURN
4010 P = 1: REM BROWSE ENTRY POINT 4020 EXPECTS P SET
4020 HOME: GOSUB 1900: I = P: GOSUB 4500
4030 VTAB 22: PRINT "N)EXT P)REV J)UMP E)DIT D)EL Q)UIT ";: GOSUB 7800
4035 IF K = 21 THEN K$ = "N"
4036 IF K = 8 THEN K$ = "P"
4040 IF K$ = "N" THEN P = P + 1: IF P > N THEN P = 1
4050 IF K$ = "P" THEN P = P - 1: IF P < 1 THEN P = N
4060 IF K$ <> "J" THEN 4070
4062 VTAB 23: PRINT "ITEM NO.? ";: L = 5: GOSUB 7000: K = VAL(A$): FOR J = 1 TO N: IF ID(J) = K THEN P = J: J = N
4064 NEXT J
4070 IF K$ = "E" THEN HOME: GOSUB 1900: PRINT "EDIT ITEM NO. ";ID(P);" (RETURN KEEPS VALUE)": I = P: GOSUB 3500: CH = 1
4080 IF K$ = "D" THEN GOSUB 4800: IF N = 0 THEN RETURN
4090 IF K$ = "Q" OR K = 27 THEN RETURN
4100 GOTO 4020
4490 REM --- SHOW RECORD I ---
4500 PRINT : PRINT "ITEM NO. ";ID(I);"   (";I;" OF ";N;")": PRINT R$
4510 PRINT "NAME:      ";N$(I)
4520 PRINT "MAKER:     ";M$(I)
4525 PRINT "SERIAL #:  ";SN$(I)
4530 PRINT "YEAR:      ";Y$(I)
4540 PRINT "TYPE:      ";T$(T(I))
4550 PRINT "CONDITION: ";C$(C(I))
4560 PRINT "LOCATION:  ";L$(I)
4565 GOSUB 7700: IF PA(I) THEN PRINT "PART OF:   ";PA(I);" ";LEFT$(PN$,20)
4567 IF SL(I) THEN GOSUB 7750: PRINT "SLOT:      ";SS$
4570 X = V(I): GOSUB 7600: PRINT "VALUE:     ";S$
4580 PRINT "NOTES:": PRINT O$(I)
4590 RETURN
4790 REM --- DELETE RECORD P ---
4800 VTAB 23: PRINT "DELETE ";LEFT$(N$(P),20);"? (Y/N) ";: GOSUB 7800: IF K$ <> "Y" THEN RETURN
4805 IF T(P) = 1 THEN DI = ID(P): GOSUB 7760
4810 IF P >= N THEN 4820
4812 FOR J = P TO N - 1: N$(J) = N$(J + 1):M$(J) = M$(J + 1):Y$(J) = Y$(J + 1):L$(J) = L$(J + 1):O$(J) = O$(J + 1):SN$(J) = SN$(J + 1)
4814 T(J) = T(J + 1):C(J) = C(J + 1):V(J) = V(J + 1):ID(J) = ID(J + 1):PA(J) = PA(J + 1):SL(J) = SL(J + 1): NEXT
4820 N$(N) = "":M$(N) = "":Y$(N) = "":L$(N) = "":O$(N) = "":SN$(N) = "":N = N - 1:CH = 1: IF P > N THEN P = N
4830 RETURN
4990 REM --- LIST ALL ---
5000 IF N = 0 THEN GOSUB 7950: RETURN
5010 R = 0: QL = 0: GOSUB 5100
5020 FOR I = 1 TO N
5030 GOSUB 5200
5040 R = R + 1: IF R < 18 OR I = N THEN 5060
5050 VTAB 24: PRINT "-- MORE: ANY KEY   Q=QUIT --";: GOSUB 7800: IF K$ = "Q" THEN QL = 1: I = N: GOTO 5060
5055 R = 0: GOSUB 5100
5060 NEXT I
5065 IF QL THEN RETURN
5070 VTAB 24: PRINT "-- END OF LIST: PRESS A KEY --";: GOSUB 7800: RETURN
5100 HOME: GOSUB 1900: PRINT "  NO. NAME";: HTAB 28: PRINT "YEAR";: HTAB 33: PRINT "TYPE": PRINT R$: RETURN
5200 PRINT RIGHT$("    " + STR$(ID(I)),5);" ";LEFT$(N$(I),20);: HTAB 28: PRINT LEFT$(Y$(I),4);: HTAB 33: PRINT LEFT$(T$(T(I)),6): RETURN
5490 REM --- SEARCH ---
5500 IF N = 0 THEN GOSUB 7950: RETURN
5510 HOME: GOSUB 1900: PRINT : PRINT "SEARCHES NAME/MAKER/SERIAL/PLACE/NOTES": PRINT "FIND> ";: L = 20: GOSUB 7000: IF A$ = "" THEN RETURN
5520 W$ = A$: GOSUB 7820: G$ = W$: LG = LEN(G$): G1 = ASC(G$): FC = 0: R = 0
5530 HOME: GOSUB 1900: PRINT "RESULTS FOR: ";G$: PRINT R$
5540 FOR I = 1 TO N: S$ = N$(I) + "|" + M$(I) + "|" + SN$(I) + "|" + L$(I) + "|" + O$(I): Z = 0
5560 IF LEN(S$) < LG THEN 5590
5570 FOR J = 1 TO LEN(S$) - LG + 1: K = ASC(MID$(S$,J,1)): IF K > 96 AND K < 123 THEN K = K - 32
5575 IF K = G1 THEN W$ = MID$(S$,J,LG): GOSUB 7820: IF W$ = G$ THEN Z = 1: J = 999
5580 NEXT J
5590 IF Z THEN GOSUB 5200: FC = FC + 1: R = R + 1
5600 IF R >= 17 THEN VTAB 24: PRINT "-- MORE: PRESS A KEY --";: GOSUB 7800: R = 0: HOME: GOSUB 1900: PRINT "RESULTS FOR: ";G$: PRINT R$
5610 NEXT I
5620 PRINT : PRINT FC;" MATCH(ES) FOUND."
5630 IF FC = 0 THEN GOSUB 7900: RETURN
5640 PRINT "VIEW ITEM NO. (RETURN = MENU)? ";: L = 5: GOSUB 7000: K = VAL(A$): Z = 0: IF A$ = "" THEN RETURN
5645 FOR J = 1 TO N: IF ID(J) = K THEN Z = J: J = N
5650 NEXT J: IF Z = 0 THEN RETURN
5655 P = Z: GOSUB 4020: RETURN
5990 REM --- SORT BY NAME (SHELL SORT) ---
6000 IF N < 2 THEN RETURN
6010 HOME: GOSUB 1900: PRINT : PRINT "SORTING ";N;" ITEMS BY NAME..."
6020 G = INT(N / 2)
6030 IF G < 1 THEN 6090
6040 FOR I = G + 1 TO N: J = I - G
6050 IF J < 1 THEN 6080
6060 IF N$(J) <= N$(J + G) THEN 6080
6070 A = J: B = J + G: GOSUB 6200: J = J - G: GOTO 6050
6080 NEXT I: G = INT(G / 2): GOTO 6030
6090 CH = 1: PRINT "DONE.": GOSUB 7900: RETURN
6200 X$ = N$(A):N$(A) = N$(B):N$(B) = X$:X$ = M$(A):M$(A) = M$(B):M$(B) = X$:X$ = Y$(A):Y$(A) = Y$(B):Y$(B) = X$
6210 X$ = L$(A):L$(A) = L$(B):L$(B) = X$:X$ = O$(A):O$(A) = O$(B):O$(B) = X$:X$ = SN$(A):SN$(A) = SN$(B):SN$(B) = X$
6220 X = T(A):T(A) = T(B):T(B) = X:X = C(A):C(A) = C(B):C(B) = X:X = V(A):V(A) = V(B):V(B) = X
6225 X = ID(A):ID(A) = ID(B):ID(B) = X:X = PA(A):PA(A) = PA(B):PA(B) = X:X = SL(A):SL(A) = SL(B):SL(B) = X: RETURN
6490 REM --- COLLECTION REPORT ---
6500 IF N = 0 THEN GOSUB 7950: RETURN
6510 HOME: GOSUB 1900: PRINT : PRINT "COLLECTION REPORT": PRINT R$
6520 FOR J = 1 TO 8: TC(J) = 0: VD(J) = 0: VC(J) = 0: NEXT: DT = 0: CT = 0
6530 FOR I = 1 TO N: K = T(I): TC(K) = TC(K) + 1: W = INT(V(I) * 100 + .5): Z = INT(W / 100): W = W - Z * 100
6535 VD(K) = VD(K) + Z: VC(K) = VC(K) + W: DT = DT + Z: CT = CT + W: NEXT
6540 PRINT "TYPE";: HTAB 17: PRINT "ITEMS";: HTAB 26: PRINT "VALUE"
6550 FOR J = 1 TO 8: PRINT T$(J);: HTAB 17: PRINT TC(J);: DD = VD(J): CC = VC(J): GOSUB 7620: HTAB 26: PRINT S$: NEXT
6560 PRINT R$: PRINT "TOTAL";: HTAB 17: PRINT N;: DD = DT: CC = CT: GOSUB 7620: HTAB 26: PRINT S$
6570 OY = 9999: OI = 0: FOR I = 1 TO N: Z = VAL(Y$(I)): IF LEN(Y$(I)) = 4 AND Z >= 1000 AND Z < OY THEN OY = Z: OI = I
6580 NEXT: IF OI THEN PRINT : PRINT "OLDEST:    ";LEFT$(N$(OI),20);" (";Y$(OI);")"
6590 MV = 0: MI = 0: FOR I = 1 TO N: IF V(I) > MV THEN MV = V(I): MI = I
6600 NEXT: IF MI THEN X = MV: GOSUB 7600: PRINT "TOP VALUE: ";LEFT$(N$(MI),16);" ";S$
6610 GOSUB 7900: RETURN
6990 REM --- LINE INPUT (ALLOWS COMMAS; L = MAX LENGTH) ---
7000 A$ = "": PRINT "_";CHR$(8);
7010 GET K$: K = ASC(K$)
7020 IF K = 13 THEN PRINT " ": RETURN
7030 IF K = 8 AND LEN(A$) > 0 THEN A$ = LEFT$(A$,LEN(A$) - 1): PRINT " ";CHR$(8);CHR$(8);"_";CHR$(8);: GOTO 7010
7040 IF K < 32 OR K = 34 OR K > 126 OR LEN(A$) >= L THEN 7010
7050 A$ = A$ + K$: PRINT K$;"_";CHR$(8);: GOTO 7010
7590 REM --- FORMAT X AS DOLLARS INTO S$ ---
7600 W = INT(X * 100 + .5): Z = INT(W / 100): W = W - Z * 100: S$ = "$" + STR$(Z) + "." + RIGHT$("0" + STR$(W),2): RETURN
7610 REM --- DOLLARS DD AND CENTS CC AS S$ (EXACT FOR BIG TOTALS) ---
7620 Z = INT(CC / 100): DD = DD + Z: CC = CC - Z * 100: S$ = STR$(DD): IF DD >= 1E9 THEN Z = INT(DD / 1E6): S$ = STR$(Z) + RIGHT$("00000" + STR$(DD - Z * 1E6),6)
7625 S$ = "$" + S$ + "." + RIGHT$("0" + STR$(CC),2): RETURN
7690 REM --- PN$ = NAME OF THE COMPUTER ITEM I IS PART OF ---
7700 PN$ = "": IF PA(I) = 0 THEN RETURN
7710 FOR PI = 1 TO N: IF ID(PI) = PA(I) THEN PN$ = N$(PI): PI = N
7720 NEXT PI: RETURN
7745 REM --- SS$ = SLOT OF ITEM I; DETACH PARTS OF DI; CHECK ITEM NOS. ---
7750 SS$ = "NONE": IF SL(I) = 9 THEN SS$ = "AUX SLOT"
7755 IF SL(I) >= 1 AND SL(I) <= 8 THEN SS$ = "SLOT " + STR$(SL(I) - 1)
7758 RETURN
7760 FOR J = 1 TO N: IF PA(J) = DI THEN PA(J) = 0
7765 NEXT J: RETURN
7770 NX = 1: FOR J = 1 TO N: IF ID(J) < 0 OR ID(J) > 65535 THEN ID(J) = 0
7772 ID(J) = INT(ID(J)): IF ID(J) >= NX THEN NX = ID(J) + 1
7775 NEXT J: FOR J = 1 TO N: IF ID(J) = 0 THEN I = J: GOSUB 7780
7778 NEXT J: RETURN
7779 REM --- GIVE ITEM I A FREE ITEM NO. (1-65535, NEVER 0) ---
7780 K = NX
7781 IF K < 1 OR K > 65535 THEN K = 1
7782 Z = 0: FOR JJ = 1 TO N: IF ID(JJ) = K AND JJ <> I THEN Z = 1: JJ = N
7783 NEXT JJ: IF Z THEN K = K + 1: GOTO 7781
7784 ID(I) = K: NX = K + 1: RETURN
7790 REM --- GET ONE KEY, FOLD LOWERCASE TO UPPER ---
7800 GET K$: K = ASC(K$): IF K > 96 AND K < 123 THEN K$ = CHR$(K - 32): K = K - 32
7810 RETURN
7815 REM --- W$ IN CAPITALS ---
7820 X$ = "": FOR JJ = 1 TO LEN(W$): K = ASC(MID$(W$,JJ,1)): IF K > 96 AND K < 123 THEN K = K - 32
7825 X$ = X$ + CHR$(K): NEXT JJ: W$ = X$: RETURN
7900 PRINT : PRINT "PRESS ANY KEY...";: GOSUB 7800: RETURN
7950 HOME: GOSUB 1900: PRINT : PRINT "NO ITEMS IN THE INVENTORY YET.": GOSUB 7900: RETURN
7990 REM --- LOAD FROM DISK (TOP LEVEL, NOT A SUBROUTINE) ---
8000 HOME: PRINT "LOADING INVENTORY...": I = 0: N = 0: EM = 1: TR = 0: ONERR GOTO 9000
8010 PRINT D$;"OPEN ";F$: PRINT D$;"READ ";F$: INPUT A$: FV = 1: IF A$ = "RETROINV2" THEN FV = 2
8012 IF A$ = "RETROINV3" THEN FV = 3
8013 IF FV > 1 THEN INPUT A$
8015 N = VAL(A$)
8020 IF N > MX THEN N = MX: TR = 2
8030 FOR I = 1 TO N: INPUT N$(I): INPUT M$(I): INPUT Y$(I): INPUT T(I): INPUT C(I): INPUT L$(I): INPUT V(I): INPUT O$(I)
8034 SN$(I) = "": ID(I) = 0: PA(I) = 0: SL(I) = 0: IF FV >= 2 THEN INPUT SN$(I)
8035 IF FV = 3 THEN INPUT ID(I): INPUT PA(I): INPUT SL(I)
8036 IF T(I) < 1 OR T(I) > 8 THEN T(I) = 6
8037 IF C(I) < 1 OR C(I) > 6 THEN C(I) = 3
8038 V(I) = INT(V(I) * 100 + .5) / 100: IF V(I) < 0 THEN V(I) = 0
8039 IF V(I) > 9999999.99 THEN V(I) = 9999999.99
8041 NEXT: EM = 3: INPUT A$: IF TR = 0 THEN TR = 3: REM MORE IN THE FILE THAN IT SAYS
8042 PRINT D$;"CLOSE ";F$
8043 POKE 216,0: CH = 0: GOSUB 7770
8045 PRINT N;" ITEMS LOADED.": IF TR = 2 THEN PRINT "THE FILE HAS MORE THAN ";MX;" ITEMS, SO": PRINT "ONLY THE FIRST ";MX;" WERE LOADED."
8047 IF TR = 3 THEN PRINT "THE FILE HOLDS MORE ITEMS THAN IT SAYS": PRINT "AND MAY BE DAMAGED."
8050 IF TR THEN PRINT "SAVING WILL ASK FOR A NEW FILE NAME.": TR = 1
8052 GOSUB 7900: GOTO 2000
8490 REM --- SAVE TO DISK (TOP LEVEL; QF=1 MEANS QUIT AFTER) ---
8500 HOME: GOSUB 1900: IF TR THEN 8600
8510 PRINT : PRINT "SAVING ";N;" ITEMS TO ";F$;"...": EM = 2: ONERR GOTO 9000
8520 PRINT D$;"OPEN ";TF$: PRINT D$;"CLOSE ";TF$: PRINT D$;"DELETE ";TF$
8530 PRINT D$;"OPEN ";TF$: PRINT D$;"WRITE ";TF$: PRINT "RETROINV3": PRINT N
8540 FOR I = 1 TO N: PRINT Q$;N$(I);Q$: PRINT Q$;M$(I);Q$: PRINT Q$;Y$(I);Q$: PRINT T(I): PRINT C(I): PRINT Q$;L$(I);Q$: X = V(I): GOSUB 7600: PRINT MID$(S$,2): PRINT Q$;O$(I);Q$
8545 PRINT Q$;SN$(I);Q$: PRINT ID(I): PRINT PA(I): PRINT SL(I): NEXT
8550 PRINT D$;"CLOSE ";TF$: EM = 4
8552 PRINT D$;"OPEN ";F$: PRINT D$;"CLOSE ";F$: PRINT D$;"DELETE ";F$: PRINT D$;"RENAME ";TF$;",";F$: POKE 216,0: CH = 0
8560 PRINT "SAVED.": GOSUB 7900: IF QF THEN 9530
8570 GOTO 2000
8590 REM --- NOT LOADED IN FULL: SAVE UNDER A NEW NAME ---
8600 PRINT : PRINT "THIS INVENTORY WAS NOT LOADED IN FULL,": PRINT "SO IT CAN'T BE SAVED OVER ";F$;".": PRINT : PRINT "NEW FILE NAME (RETURN CANCELS)"
8610 PRINT "> ";: L = 15: GOSUB 7000: W$ = A$: GOSUB 7820: IF W$ = "" THEN QF = 0: GOTO 2000
8620 IF W$ = F$ OR W$ = TF$ OR LEFT$(W$,1) < "A" OR LEFT$(W$,1) > "Z" THEN PRINT "PLEASE CHOOSE ANOTHER NAME.": GOTO 8610
8630 F$ = W$: TR = 0: GOTO 8510
8990 REM --- DISK ERROR HANDLER (ALWAYS ENTERED AT TOP LEVEL) ---
9000 E = PEEK(222): POKE 216,0: PRINT : PRINT D$;"CLOSE"
9002 IF EM = 3 AND E = 5 THEN 8043
9004 IF EM = 2 THEN ONERR GOTO 9008
9006 IF EM = 2 THEN PRINT D$;"DELETE ";TF$
9008 POKE 216,0: IF EM <> 1 THEN 9040
9010 IF I = 0 AND (E = 5 OR E = 6) THEN N = 0: PRINT "STARTING A NEW INVENTORY.": GOTO 9032
9012 N = I - 1: IF N < 0 THEN N = 0
9014 TR = 1: IF E = 77 THEN PRINT "OUT OF MEMORY."
9016 IF E = 5 THEN PRINT "THE FILE IS SHORTER THAN IT SAYS."
9018 IF E <> 5 AND E <> 77 THEN PRINT "DISK ERROR #";E
9020 PRINT N;" ITEMS LOADED.": PRINT "SAVING WILL ASK FOR A NEW FILE NAME."
9032 CH = 0: GOSUB 7770: GOSUB 7900: GOTO 2000
9040 PRINT : PRINT "DISK ERROR #";E: IF EM = 2 THEN PRINT "SAVE FAILED. THE FILE ON DISK": PRINT "WAS NOT CHANGED."
9042 IF EM = 4 THEN PRINT "YOUR CHANGES ARE IN ";TF$;"."
9050 IF E = 4 THEN PRINT "DISK IS WRITE PROTECTED."
9060 IF E = 8 THEN PRINT "I/O ERROR - CHECK DISK/DRIVE."
9070 IF E = 9 THEN PRINT "DISK FULL."
9080 QF = 0: GOSUB 7900: GOTO 2000
9490 REM --- QUIT ---
9500 IF CH = 0 THEN 9530
9510 HOME: GOSUB 1900: PRINT : PRINT "YOU HAVE UNSAVED CHANGES.": PRINT "SAVE FIRST? (Y/N, C=CANCEL) ";: GOSUB 7800
9520 IF K$ = "C" OR K = 27 THEN 2000
9522 IF K$ = "Y" THEN QF = 1: GOTO 8500
9524 IF K$ <> "Y" AND K$ <> "N" THEN 9510
9530 HOME: VTAB 10: HTAB 8: PRINT "THANKS FOR USING RETROINV": HTAB 15: PRINT "BY 6502RETRO": VTAB 20: END
